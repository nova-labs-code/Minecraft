<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"
    >

    <meta
        name="apple-mobile-web-app-capable"
        content="yes"
    >

    <meta
        name="mobile-web-app-capable"
        content="yes"
    >

    <meta
        name="format-detection"
        content="telephone=no"
    >

    <title>Minecraft Survival Checklist</title>

    <style>
        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        html {
            margin: 0;
            padding: 0;
            background: #080a0f;
            touch-action: manipulation;
            -webkit-text-size-adjust: 100%;
        }

        body {
            margin: 0;
            padding: 0;
            min-width: 0;
            background:
                radial-gradient(
                    circle at top,
                    #151a25 0,
                    #0b0e14 42%,
                    #080a0f 100%
                );
            color: #f1f4f8;
            font-family:
                Inter,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;
            line-height: 1.5;
            touch-action: manipulation;
            -webkit-text-size-adjust: 100%;
        }

        button,
        input {
            font: inherit;
        }

        button {
            touch-action: manipulation;
        }

        a {
            color: inherit;
        }

        .page {
            width: min(1180px, calc(100% - 32px));
            margin: 0 auto;
            padding: 28px 0 50px;
        }

        /* =========================
           HEADER
        ========================= */

        .header {
            margin-bottom: 22px;
        }

        .eyebrow {
            margin: 0 0 7px;
            color: #8f9bad;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        h1 {
            margin: 0;
            color: #ffffff;
            font-size: clamp(28px, 5vw, 42px);
            line-height: 1.08;
            letter-spacing: -0.035em;
        }

        .subtitle {
            max-width: 720px;
            margin: 10px 0 0;
            color: #9ca7b7;
            font-size: 15px;
        }

        /* =========================
           CONTROLS
        ========================= */

        .controls {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto auto;
            gap: 10px;
            margin-bottom: 18px;
        }

        .search-wrap {
            position: relative;
            min-width: 0;
        }

        .search-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #788396;
            font-size: 16px;
            pointer-events: none;
        }

        .search {
            width: 100%;
            min-height: 46px;
            padding: 0 14px 0 40px;
            border: 1px solid #252d3a;
            border-radius: 10px;
            outline: none;
            background: #10141c;
            color: #ffffff;
            transition:
                border-color 0.15s ease,
                background 0.15s ease;
        }

        .search::placeholder {
            color: #667182;
        }

        .search:focus {
            border-color: #56657b;
            background: #121720;
        }

        .button {
            min-height: 46px;
            padding: 0 17px;
            border: 1px solid #2b3442;
            border-radius: 10px;
            background: #151a23;
            color: #e9edf3;
            font-size: 14px;
            font-weight: 750;
            cursor: pointer;
            white-space: nowrap;
            transition:
                background 0.15s ease,
                border-color 0.15s ease,
                transform 0.08s ease;
        }

        .button:hover {
            background: #1b222e;
            border-color: #3b4657;
        }

        .button:active {
            transform: translateY(1px);
        }

        .button.primary {
            border-color: #4c607d;
            background: #26364c;
        }

        .button.primary:hover {
            background: #30445e;
        }

        .button.danger {
            border-color: #57333a;
            color: #ffb8c0;
        }

        .button.danger:hover {
            background: #29171b;
            border-color: #70414a;
        }

        /* =========================
           SCORE AREA
        ========================= */

        .dashboard {
            display: grid;
            gap: 14px;
            margin-bottom: 18px;
        }

        .score-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 10px;
        }

        .score-card {
            min-width: 0;
            padding: 16px;
            border: 1px solid #202733;
            border-radius: 12px;
            background: rgba(15, 19, 27, 0.94);
        }

        .score-label {
            margin-bottom: 6px;
            color: #7f8a9b;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .score-value {
            display: flex;
            align-items: baseline;
            gap: 5px;
            min-width: 0;
            color: #ffffff;
            font-size: 24px;
            font-weight: 850;
            letter-spacing: -0.025em;
        }

        .score-value small {
            color: #7d8796;
            font-size: 12px;
            font-weight: 700;
        }

        .score-subtext {
            margin-top: 5px;
            overflow: hidden;
            color: #737f90;
            font-size: 12px;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .rank-line {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-top: 7px;
        }

        .rank-badge {
            display: inline-flex;
            align-items: center;
            min-height: 22px;
            padding: 0 8px;
            border: 1px solid #343d4b;
            border-radius: 6px;
            background: #151a22;
            color: #dbe1e9;
            font-size: 10px;
            font-weight: 850;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        /* =========================
           PROGRESS
        ========================= */

        .progress-panel {
            padding: 16px;
            border: 1px solid #202733;
            border-radius: 12px;
            background: rgba(15, 19, 27, 0.94);
        }

        .progress-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 9px;
        }

        .progress-title {
            color: #dfe5ed;
            font-size: 13px;
            font-weight: 800;
        }

        .progress-percent {
            color: #8995a6;
            font-size: 12px;
            font-weight: 800;
        }

        .progress-track {
            width: 100%;
            height: 8px;
            overflow: hidden;
            border-radius: 999px;
            background: #202632;
        }

        .progress-fill {
            width: 0;
            height: 100%;
            border-radius: inherit;
            background: #687c9b;
            transition: width 0.2s ease;
        }

        /* =========================
           PROFILES
        ========================= */

        .section {
            margin-top: 18px;
        }

        .section-heading {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 10px;
        }

        .section-heading h2 {
            margin: 0;
            color: #ffffff;
            font-size: 18px;
            letter-spacing: -0.02em;
        }

        .section-heading p {
            margin: 3px 0 0;
            color: #737e8e;
            font-size: 12px;
        }

        .profile-count {
            flex: 0 0 auto;
            color: #727d8e;
            font-size: 12px;
            font-weight: 750;
        }

        .profiles {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 10px;
        }

        .profile {
            position: relative;
            min-width: 0;
            padding: 14px;
            border: 1px solid #232b37;
            border-radius: 12px;
            background: #10141c;
            cursor: pointer;
            transition:
                border-color 0.15s ease,
                background 0.15s ease;
        }

        .profile:hover {
            border-color: #354153;
            background: #131822;
        }

        .profile.active {
            border-color: #596b86;
            background: #151b25;
        }

        .profile-top {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }

        .profile-avatar {
            display: grid;
            flex: 0 0 auto;
            width: 38px;
            height: 38px;
            place-items: center;
            border: 1px solid #303a49;
            border-radius: 9px;
            background: #1a202b;
            color: #dfe5ec;
            font-size: 14px;
            font-weight: 900;
        }

        .profile-info {
            min-width: 0;
        }

        .profile-name {
            overflow: hidden;
            color: #f2f5f8;
            font-size: 14px;
            font-weight: 800;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .profile-rank {
            margin-top: 2px;
            color: #7e8999;
            font-size: 11px;
            font-weight: 700;
        }

        .profile-score {
            margin-top: 11px;
            color: #ffffff;
            font-size: 18px;
            font-weight: 850;
        }

        .profile-score small {
            color: #707c8d;
            font-size: 11px;
        }

        .profile-status {
            margin-top: 2px;
            color: #6f7a8a;
            font-size: 11px;
        }

        .profile-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 7px;
            margin-top: 11px;
        }

        .profile-action {
            min-height: 34px;
            border: 1px solid #293240;
            border-radius: 7px;
            background: #151a23;
            color: #aeb7c5;
            font-size: 11px;
            font-weight: 800;
            cursor: pointer;
        }

        .profile-action:hover {
            background: #1b222d;
            color: #ffffff;
        }

        .profile-action.delete {
            border-color: #4c3037;
            color: #d9949d;
        }

        .empty-profiles {
            padding: 20px;
            border: 1px dashed #2b3441;
            border-radius: 12px;
            color: #788394;
            text-align: center;
            font-size: 13px;
        }

        /* =========================
           CATEGORIES
        ========================= */

        #categories {
            display: grid;
            gap: 9px;
            margin-top: 18px;
        }

        .category {
            overflow: hidden;
            border: 1px solid #222a36;
            border-radius: 12px;
            background: #0f131a;
        }

        .category-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            width: 100%;
            min-height: 58px;
            padding: 13px 15px;
            border: 0;
            background: transparent;
            color: inherit;
            text-align: left;
            cursor: pointer;
        }

        .category-header:hover {
            background: #121720;
        }

        .category-title-wrap {
            min-width: 0;
        }

        .category-title {
            overflow: hidden;
            color: #eef2f6;
            font-size: 14px;
            font-weight: 850;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .category-meta {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 2px;
            color: #707b8b;
            font-size: 11px;
            font-weight: 700;
        }

        .category-score {
            color: #8995a5;
        }

        .category-arrow {
            flex: 0 0 auto;
            color: #687486;
            font-size: 15px;
            transition: transform 0.15s ease;
        }

        .category.open .category-arrow {
            transform: rotate(180deg);
        }

        .category-body {
            display: none;
            padding: 0 10px 10px;
        }

        .category.open .category-body {
            display: grid;
            gap: 6px;
        }

        /* =========================
           CHECKLIST ITEMS
        ========================= */

        .check-item {
            display: grid;
            grid-template-columns: 22px minmax(0, 1fr) auto;
            align-items: center;
            gap: 10px;
            min-width: 0;
            padding: 11px;
            border: 1px solid #1f2631;
            border-radius: 9px;
            background: #121720;
            transition:
                background 0.12s ease,
                border-color 0.12s ease;
        }

        .check-item:hover {
            border-color: #2b3544;
            background: #151b25;
        }

        .check-item.completed {
            background: #10151d;
        }

        .check-item.completed .item-text {
            color: #667181;
            text-decoration: line-through;
            text-decoration-thickness: 1px;
        }

        .check-box {
            position: relative;
            display: grid;
            width: 20px;
            height: 20px;
            place-items: center;
        }

        .check-box input {
            position: absolute;
            width: 20px;
            height: 20px;
            margin: 0;
            opacity: 0;
            cursor: pointer;
        }

        .check-mark {
            display: grid;
            width: 20px;
            height: 20px;
            place-items: center;
            border: 1px solid #3b4554;
            border-radius: 5px;
            background: #0d1117;
            color: transparent;
            font-size: 13px;
            font-weight: 900;
            pointer-events: none;
        }

        .check-box input:checked + .check-mark {
            border-color: #667c9d;
            background: #4f6380;
            color: #ffffff;
        }

        .item-content {
            min-width: 0;
        }

        .item-text {
            color: #dce2e9;
            font-size: 13px;
            font-weight: 650;
            overflow-wrap: anywhere;
        }

        .item-requirement {
            margin-top: 3px;
            color: #717d8d;
            font-size: 11px;
            line-height: 1.4;
        }

        .item-badge {
            flex: 0 0 auto;
            align-self: center;
            padding: 4px 7px;
            border: 1px solid #303948;
            border-radius: 5px;
            background: #171d27;
            color: #9da8b7;
            font-size: 9px;
            font-weight: 900;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .item-badge.easy {
            color: #9aa9bb;
        }

        .item-badge.medium {
            color: #aeb6c2;
        }

        .item-badge.hard {
            color: #c3cbd5;
        }

        .item-badge.epic {
            border-color: #4a5362;
            color: #e1e5ea;
        }

        .achievement-score {
            display: inline-flex;
            align-items: center;
            gap: 3px;
            flex: 0 0 auto;
            color: #aab4c1;
            font-size: 11px;
            font-weight: 850;
            white-space: nowrap;
        }

        .achievement-score strong {
            color: #ffffff;
            font-size: 13px;
        }

        /* =========================
           NO RESULTS
        ========================= */

        .no-results {
            padding: 28px 15px;
            border: 1px dashed #2a3340;
            border-radius: 12px;
            color: #768293;
            text-align: center;
            font-size: 13px;
        }

        /* =========================
           FOOTER
        ========================= */

        footer {
            margin-top: 30px;
            padding-top: 18px;
            border-top: 1px solid #1d242f;
            color: #596474;
            font-size: 11px;
            text-align: center;
        }

        /* =========================
           MODALS
        ========================= */

        .modal-backdrop {
            position: fixed;
            z-index: 1000;
            inset: 0;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 18px;
            background: rgba(3, 5, 8, 0.78);
            backdrop-filter: blur(6px);
        }

        .modal-backdrop.visible {
            display: flex;
        }

        .modal {
            width: min(430px, 100%);
            max-height: calc(100dvh - 36px);
            overflow: auto;
            padding: 20px;
            border: 1px solid #2b3441;
            border-radius: 14px;
            background: #10141c;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
        }

        .modal h2 {
            margin: 0;
            color: #ffffff;
            font-size: 19px;
        }

        .modal-text {
            margin: 7px 0 17px;
            color: #7d8898;
            font-size: 12px;
        }

        .modal-label {
            display: block;
            margin-bottom: 6px;
            color: #aab4c2;
            font-size: 11px;
            font-weight: 800;
        }

        .modal-input {
            width: 100%;
            min-height: 44px;
            padding: 0 12px;
            border: 1px solid #293240;
            border-radius: 9px;
            outline: none;
            background: #0c1016;
            color: #ffffff;
        }

        .modal-input:focus {
            border-color: #53647d;
        }

        .modal-buttons {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin-top: 15px;
        }

        .confirm-buttons {
            grid-template-columns: 1fr 1fr;
        }

        /* =========================
           MOBILE
        ========================= */

        @media (max-width: 900px) {
            .score-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .profiles {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .controls {
                grid-template-columns: minmax(0, 1fr) auto;
            }

            .controls .button:last-child {
                grid-column: 1 / -1;
            }
        }

        @media (max-width: 620px) {
            .page {
                width: calc(100% - 18px);
                padding-top: 18px;
                padding-bottom: 30px;
            }

            .controls {
                grid-template-columns: 1fr;
            }

            .controls .button:last-child {
                grid-column: auto;
            }

            .button {
                width: 100%;
            }

            .profiles {
                grid-template-columns: 1fr;
            }

            .section-heading {
                align-items: flex-start;
            }

            .check-item {
                grid-template-columns: 22px minmax(0, 1fr);
            }

            .item-badge,
            .achievement-score {
                grid-column: 2;
                justify-self: start;
            }
        }

        @media (max-width: 420px) {
            .page {
                width: calc(100% - 14px);
            }

            h1 {
                font-size: 29px;
            }

            .subtitle {
                font-size: 13px;
            }

            .score-grid {
                grid-template-columns: 1fr;
            }

            .score-card {
                padding: 14px;
            }

            .category-header {
                min-height: 54px;
                padding: 12px;
            }

            .category-title {
                font-size: 13px;
            }

            .category-body {
                padding: 0 7px 7px;
            }

            .check-item {
                padding: 10px;
            }

            .item-text {
                font-size: 12px;
            }

            .modal-backdrop {
                padding: 10px;
            }

            .modal {
                padding: 16px;
            }
        }
    </style>
</head>

<body>

<div class="page">

    <header class="header">
        <p class="eyebrow">Minecraft Bedrock Edition • Xbox</p>

        <h1>Minecraft Survival Checklist</h1>

        <p class="subtitle">
            Track survival goals, Xbox achievements, Gamerscore,
            and progress across your profiles.
        </p>
    </header>

    <section class="controls">
        <div class="search-wrap">
            <span class="search-icon">⌕</span>

            <input
                id="searchInput"
                class="search"
                type="search"
                placeholder="Search goals and achievements..."
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
            >
        </div>

        <button
            id="addProfileButton"
            class="button primary"
            type="button"
        >
            Add Profile
        </button>

        <button
            id="resetButton"
            class="button danger"
            type="button"
        >
            Reset Goals
        </button>
    </section>

    <section class="dashboard">

        <div class="score-grid">

            <div class="score-card">
                <div class="score-label">Global Score</div>

                <div class="score-value">
                    <span id="globalScore">0</span>
                    <small>G</small>
                </div>

                <div
                    id="globalScoreSubtext"
                    class="score-subtext"
                >
                    0 / 0 possible
                </div>
            </div>

            <div class="score-card">
                <div class="score-label">Current Profile</div>

                <div class="score-value">
                    <span id="profileScore">0</span>
                    <small>G</small>
                </div>

                <div class="rank-line">
                    <span
                        id="profileRank"
                        class="rank-badge"
                    >
                        Dirt
                    </span>
                </div>
            </div>

            <div class="score-card">
                <div class="score-label">Achievements</div>

                <div class="score-value">
                    <span id="achievementProgress">0</span>
                    <small>/ 133</small>
                </div>

                <div
                    id="achievementScoreText"
                    class="score-subtext"
                >
                    0G earned
                </div>
            </div>

            <div class="score-card">
                <div class="score-label">Goals</div>

                <div class="score-value">
                    <span id="goalProgress">0</span>
                    <small>completed</small>
                </div>

                <div
                    id="goalScoreText"
                    class="score-subtext"
                >
                    0G earned
                </div>
            </div>

        </div>

        <div class="progress-panel">

            <div class="progress-top">
                <span class="progress-title">
                    Overall Progress
                </span>

                <span
                    id="progressPercent"
                    class="progress-percent"
                >
                    0%
                </span>
            </div>

            <div class="progress-track">
                <div
                    id="progressFill"
                    class="progress-fill"
                ></div>
            </div>

        </div>

    </section>

    <section class="section">

        <div class="section-heading">
            <div>
                <h2>Profiles</h2>

                <p>
                    Achievement progress is tracked separately for each player.
                </p>
            </div>

            <span
                id="profileCount"
                class="profile-count"
            >
                0 / 12
            </span>
        </div>

        <div
            id="profiles"
            class="profiles"
        ></div>

    </section>

    <main id="categories"></main>

    <footer>
        Minecraft Survival Checklist
    </footer>

</div>


<!-- =========================
     PROFILE MODAL
========================= -->

<div
    id="profileModal"
    class="modal-backdrop"
    aria-hidden="true"
>
    <div
        class="modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="profileModalTitle"
    >

        <h2 id="profileModalTitle">
            Add Profile
        </h2>

        <p class="modal-text">
            Choose a name for this player profile.
        </p>

        <label
            class="modal-label"
            for="profileNameInput"
        >
            Profile Name
        </label>

        <input
            id="profileNameInput"
            class="modal-input"
            type="text"
            maxlength="30"
            autocomplete="off"
            spellcheck="false"
            placeholder="Enter a profile name"
        >

        <div class="modal-buttons">

            <button
                id="profileCancelButton"
                class="button"
                type="button"
            >
                Cancel
            </button>

            <button
                id="profileSaveButton"
                class="button primary"
                type="button"
            >
                Save Profile
            </button>

        </div>

    </div>
</div>


<!-- =========================
     CONFIRM MODAL
========================= -->

<div
    id="confirmModal"
    class="modal-backdrop"
    aria-hidden="true"
>
    <div
        class="modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="confirmModalTitle"
    >

        <h2 id="confirmModalTitle">
            Reset Goals?
        </h2>

        <p
            id="confirmModalText"
            class="modal-text"
        >
            This will reset the selected progress.
        </p>

        <div class="modal-buttons confirm-buttons">

            <button
                id="confirmCancelButton"
                class="button"
                type="button"
            >
                Cancel
            </button>

            <button
                id="confirmOkayButton"
                class="button danger"
                type="button"
            >
                Reset
            </button>

        </div>

    </div>
</div>


<script>
"use strict";

/* =========================
   SETTINGS
========================= */

const GOALS_FILE = "goals.json";

const GOAL_STORAGE_KEY =
    "minecraft-survival-goals-v1";

const PROFILES_STORAGE_KEY =
    "minecraft-survival-profiles-v2";

const ACTIVE_PROFILE_STORAGE_KEY =
    "minecraft-active-profile-v2";

const MAX_PROFILES = 12;

const DIFFICULTY_SCORES = {
    easy: 10,
    medium: 25,
    hard: 50,
    epic: 100
};

const DEFAULT_DIFFICULTY = "medium";


/* =========================
   RANKS
========================= */

const RANKS = [
    {
        name: "Dirt",
        min: 0,
        max: 49
    },
    {
        name: "Wood",
        min: 50,
        max: 149
    },
    {
        name: "Stone",
        min: 150,
        max: 299
    },
    {
        name: "Coal",
        min: 300,
        max: 499
    },
    {
        name: "Iron",
        min: 500,
        max: 749
    },
    {
        name: "Gold",
        min: 750,
        max: 999
    },
    {
        name: "Diamond",
        min: 1000,
        max: 1499
    },
    {
        name: "Emerald",
        min: 1500,
        max: 1999
    },
    {
        name: "Netherite",
        min: 2000,
        max: 2499
    },
    {
        name: "Ender Dragon",
        min: 2500,
        max: 2980
    }
];


/* =========================
   STATE
========================= */

let goalsData = null;

let sharedGoals = {};

let profiles = [];

let activeProfileId = null;

let currentSearch = "";

let editingProfileId = null;

let confirmAction = null;


/* =========================
   ELEMENTS
========================= */

const searchInput =
    document.getElementById("searchInput");

const categoriesElement =
    document.getElementById("categories");

const profilesElement =
    document.getElementById("profiles");

const globalScoreElement =
    document.getElementById("globalScore");

const globalScoreSubtextElement =
    document.getElementById("globalScoreSubtext");

const profileScoreElement =
    document.getElementById("profileScore");

const profileRankElement =
    document.getElementById("profileRank");

const achievementProgressElement =
    document.getElementById("achievementProgress");

const achievementScoreTextElement =
    document.getElementById("achievementScoreText");

const goalProgressElement =
    document.getElementById("goalProgress");

const goalScoreTextElement =
    document.getElementById("goalScoreText");

const progressPercentElement =
    document.getElementById("progressPercent");

const progressFillElement =
    document.getElementById("progressFill");

const profileCountElement =
    document.getElementById("profileCount");

const addProfileButton =
    document.getElementById("addProfileButton");

const resetButton =
    document.getElementById("resetButton");

const profileModal =
    document.getElementById("profileModal");

const profileModalTitle =
    document.getElementById("profileModalTitle");

const profileNameInput =
    document.getElementById("profileNameInput");

const profileSaveButton =
    document.getElementById("profileSaveButton");

const profileCancelButton =
    document.getElementById("profileCancelButton");

const confirmModal =
    document.getElementById("confirmModal");

const confirmModalText =
    document.getElementById("confirmModalText");

const confirmOkayButton =
    document.getElementById("confirmOkayButton");

const confirmCancelButton =
    document.getElementById("confirmCancelButton");


/* =========================
   STORAGE
========================= */

function loadStorage() {

    try {
        const savedGoals =
            localStorage.getItem(
                GOAL_STORAGE_KEY
            );

        if (savedGoals) {
            sharedGoals =
                JSON.parse(savedGoals) || {};
        }
    } catch {
        sharedGoals = {};
    }


    try {
        const savedProfiles =
            localStorage.getItem(
                PROFILES_STORAGE_KEY
            );

        if (savedProfiles) {
            profiles =
                JSON.parse(savedProfiles) || [];
        }
    } catch {
        profiles = [];
    }


    try {
        const savedActive =
            localStorage.getItem(
                ACTIVE_PROFILE_STORAGE_KEY
            );

        if (savedActive) {
            activeProfileId = savedActive;
        }
    } catch {
        activeProfileId = null;
    }


    normalizeProfiles();
}


function saveGoals() {

    localStorage.setItem(
        GOAL_STORAGE_KEY,
        JSON.stringify(sharedGoals)
    );
}


function saveProfiles() {

    localStorage.setItem(
        PROFILES_STORAGE_KEY,
        JSON.stringify(profiles)
    );
}


function saveActiveProfile() {

    if (activeProfileId) {
        localStorage.setItem(
            ACTIVE_PROFILE_STORAGE_KEY,
            activeProfileId
        );
    }
}


/* =========================
   PROFILE NORMALIZATION
========================= */

function normalizeProfiles() {

    if (!Array.isArray(profiles)) {
        profiles = [];
    }

    profiles = profiles
        .filter(profile =>
            profile &&
            typeof profile === "object" &&
            profile.id
        )
        .slice(0, MAX_PROFILES)
        .map(profile => ({
            id: String(profile.id),

            name:
                typeof profile.name === "string" &&
                profile.name.trim()
                    ? profile.name.trim()
                    : "Player",

            achievements:
                profile.achievements &&
                typeof profile.achievements === "object"
                    ? profile.achievements
                    : {}
        }));


    if (
        !activeProfileId ||
        !profiles.some(
            profile =>
                profile.id === activeProfileId
        )
    ) {
        activeProfileId =
            profiles[0]?.id || null;
    }
}


/* =========================
   DATA HELPERS
========================= */

/*
    IMPORTANT:
    This intentionally uses ONLY:

        goalsData.categories[]

    and:

        category.items[]

    There is no recursive category detection.
*/

function getCategories() {

    if (
        !goalsData ||
        !Array.isArray(goalsData.categories)
    ) {
        return [];
    }

    return goalsData.categories;
}


function getNormalGoalCategories() {

    return getCategories().filter(
        category =>
            category.type !== "achievements"
    );
}


function getAchievementCategory() {

    return getCategories().find(
        category =>
            category.type === "achievements"
    );
}


function getNormalGoals() {

    const result = [];

    for (const category of getNormalGoalCategories()) {

        if (!Array.isArray(category.items)) {
            continue;
        }

        for (const item of category.items) {

            if (!item || !item.id) {
                continue;
            }

            result.push(item);
        }
    }

    return result;
}


function getAchievements() {

    const category =
        getAchievementCategory();

    if (
        !category ||
        !Array.isArray(category.items)
    ) {
        return [];
    }

    return category.items.filter(
        item =>
            item &&
            item.id
    );
}


function isGoalCompleted(id) {

    return sharedGoals[id] === true;
}


function isAchievementCompleted(
    profile,
    id
) {

    return Boolean(
        profile &&
        profile.achievements &&
        profile.achievements[id] === true
    );
}


function getGoalScore(goal) {

    const difficulty =
        String(
            goal.difficulty ||
            DEFAULT_DIFFICULTY
        ).toLowerCase();

    return (
        DIFFICULTY_SCORES[difficulty] ||
        DIFFICULTY_SCORES[
            DEFAULT_DIFFICULTY
        ]
    );
}


function getSharedGoalScore() {

    let score = 0;

    for (const goal of getNormalGoals()) {

        if (isGoalCompleted(goal.id)) {
            score += getGoalScore(goal);
        }
    }

    return score;
}


function getSharedGoalCompletedCount() {

    let count = 0;

    for (const goal of getNormalGoals()) {

        if (isGoalCompleted(goal.id)) {
            count++;
        }
    }

    return count;
}


function getTotalGoalScore() {

    return getNormalGoals().reduce(
        (total, goal) =>
            total + getGoalScore(goal),
        0
    );
}


function getProfileAchievementScore(
    profile
) {

    if (!profile) {
        return 0;
    }

    return getAchievements().reduce(
        (total, achievement) => {

            if (
                isAchievementCompleted(
                    profile,
                    achievement.id
                )
            ) {
                return (
                    total +
                    Number(
                        achievement.gamerscore
                    ) || 0
                );
            }

            return total;
        },
        0
    );
}


function getProfileAchievementCount(
    profile
) {

    if (!profile) {
        return 0;
    }

    return getAchievements().filter(
        achievement =>
            isAchievementCompleted(
                profile,
                achievement.id
            )
    ).length;
}


function getCurrentProfile() {

    return profiles.find(
        profile =>
            profile.id === activeProfileId
    ) || null;
}


function getCurrentProfileScore() {

    return (
        getSharedGoalScore() +
        getProfileAchievementScore(
            getCurrentProfile()
        )
    );
}


function getGlobalAchievementScore() {

    return profiles.reduce(
        (total, profile) =>
            total +
            getProfileAchievementScore(
                profile
            ),
        0
    );
}


function getGlobalAchievementCount() {

    return profiles.reduce(
        (total, profile) =>
            total +
            getProfileAchievementCount(
                profile
            ),
        0
    );
}


function getGlobalScore() {

    return (
        getSharedGoalScore() +
        getGlobalAchievementScore()
    );
}


function getGlobalPossibleScore() {

    return (
        getTotalGoalScore() +
        getAchievements().reduce(
            (total, achievement) =>
                total +
                Number(
                    achievement.gamerscore
                ) || 0,
            0
        ) * profiles.length
    );
}


/* =========================
   RANK
========================= */

function getRank(score) {

    let currentRank = RANKS[0];

    for (const rank of RANKS) {

        if (score >= rank.min) {
            currentRank = rank;
        }
    }

    return currentRank;
}


/* =========================
   PROFILE HELPERS
========================= */

function createProfileId() {

    return (
        Date.now().toString(36) +
        Math.random()
            .toString(36)
            .slice(2, 8)
    );
}


function getProfileInitial(name) {

    const clean =
        String(name || "P")
            .trim();

    return (
        clean.charAt(0).toUpperCase() ||
        "P"
    );
}


function addProfile(name) {

    if (profiles.length >= MAX_PROFILES) {
        return;
    }

    const cleanName =
        String(name || "")
            .trim()
            .slice(0, 30);

    if (!cleanName) {
        return;
    }

    const profile = {
        id: createProfileId(),
        name: cleanName,
        achievements: {}
    };

    profiles.push(profile);

    activeProfileId = profile.id;

    saveProfiles();
    saveActiveProfile();

    renderAll();
}


function renameProfile(id, name) {

    const profile =
        profiles.find(
            item => item.id === id
        );

    if (!profile) {
        return;
    }

    const cleanName =
        String(name || "")
            .trim()
            .slice(0, 30);

    if (!cleanName) {
        return;
    }

    profile.name = cleanName;

    saveProfiles();

    renderAll();
}


function deleteProfile(id) {

    if (profiles.length <= 1) {
        return;
    }

    const index =
        profiles.findIndex(
            profile => profile.id === id
        );

    if (index === -1) {
        return;
    }

    profiles.splice(index, 1);

    if (activeProfileId === id) {
        activeProfileId =
            profiles[0]?.id || null;

        saveActiveProfile();
    }

    saveProfiles();

    renderAll();
}


function selectProfile(id) {

    if (
        !profiles.some(
            profile => profile.id === id
        )
    ) {
        return;
    }

    activeProfileId = id;

    saveActiveProfile();

    renderAll();
}


/* =========================
   PROFILE RENDER
========================= */

function renderProfiles() {

    profilesElement.innerHTML = "";

    profileCountElement.textContent =
        `${profiles.length} / ${MAX_PROFILES}`;


    if (!profiles.length) {

        profilesElement.innerHTML = `
            <div class="empty-profiles">
                Add a profile to start tracking Xbox achievements.
            </div>
        `;

        return;
    }


    for (const profile of profiles) {

        const card =
            document.createElement("article");

        card.className = "profile";

        if (
            profile.id === activeProfileId
        ) {
            card.classList.add("active");
        }


        const achievementCount =
            getProfileAchievementCount(
                profile
            );

        const achievementScore =
            getProfileAchievementScore(
                profile
            );

        const score =
            getSharedGoalScore() +
            achievementScore;

        const rank =
            getRank(score);


        card.innerHTML = `
            <div class="profile-top">

                <div class="profile-avatar">
                    ${escapeHtml(
                        getProfileInitial(
                            profile.name
                        )
                    )}
                </div>

                <div class="profile-info">

                    <div class="profile-name">
                        ${escapeHtml(
                            profile.name
                        )}
                    </div>

                    <div class="profile-rank">
                        ${escapeHtml(
                            rank.name
                        )}
                    </div>

                </div>

            </div>

            <div class="profile-score">
                ${score}G
                <small>total</small>
            </div>

            <div class="profile-status">
                ${achievementCount} /
                ${getAchievements().length}
                achievements •
                ${achievementScore}G earned
            </div>

            <div class="profile-actions">

                <button
                    class="profile-action"
                    type="button"
                    data-action="select"
                    data-id="${escapeAttribute(
                        profile.id
                    )}"
                >
                    Select
                </button>

                <button
                    class="profile-action"
                    type="button"
                    data-action="rename"
                    data-id="${escapeAttribute(
                        profile.id
                    )}"
                >
                    Rename
                </button>

                <button
                    class="profile-action delete"
                    type="button"
                    data-action="delete"
                    data-id="${escapeAttribute(
                        profile.id
                    )}"
                >
                    Delete
                </button>

            </div>
        `;


        card.addEventListener(
            "click",
            event => {

                const button =
                    event.target.closest(
                        "button"
                    );

                if (button) {
                    return;
                }

                selectProfile(profile.id);
            }
        );


        profilesElement.appendChild(card);
    }
}


/* =========================
   CATEGORY RENDER
========================= */

function renderCategories() {

    categoriesElement.innerHTML = "";

    const categories =
        getCategories();


    if (!categories.length) {

        categoriesElement.innerHTML = `
            <div class="no-results">
                No categories were found.
            </div>
        `;

        return;
    }


    let visibleCategoryCount = 0;


    for (
        const category of categories
    ) {

        if (
            !Array.isArray(
                category.items
            )
        ) {
            continue;
        }


        const items =
            category.items.filter(
                item =>
                    matchesSearch(
                        item,
                        category
                    )
            );


        if (
            currentSearch &&
            items.length === 0
        ) {
            continue;
        }


        visibleCategoryCount++;


        const categoryElement =
            document.createElement("section");

        categoryElement.className =
            "category";


        const isAchievements =
            category.type === "achievements";


        const completedCount =
            items.filter(item => {

                if (isAchievements) {

                    return isAchievementCompleted(
                        getCurrentProfile(),
                        item.id
                    );
                }

                return isGoalCompleted(
                    item.id
                );

            }).length;


        let possibleScore = 0;

        for (const item of items) {

            possibleScore +=
                isAchievements
                    ? Number(
                        item.gamerscore
                    ) || 0
                    : getGoalScore(item);
        }


        const earnedScore =
            items.reduce(
                (total, item) => {

                    const completed =
                        isAchievements
                            ? isAchievementCompleted(
                                getCurrentProfile(),
                                item.id
                            )
                            : isGoalCompleted(
                                item.id
                            );

                    if (!completed) {
                        return total;
                    }

                    return (
                        total +
                        (
                            isAchievements
                                ? Number(
                                    item.gamerscore
                                ) || 0
                                : getGoalScore(item)
                        )
                    );
                },
                0
            );


        categoryElement.innerHTML = `
            <button
                class="category-header"
                type="button"
            >

                <div class="category-title-wrap">

                    <div class="category-title">
                        ${escapeHtml(
                            category.title ||
                            category.id ||
                            "Category"
                        )}
                    </div>

                    <div class="category-meta">

                        <span>
                            ${completedCount}
                            /
                            ${items.length}
                        </span>

                        <span>•</span>

                        <span class="category-score">
                            ${earnedScore}G /
                            ${possibleScore}G
                        </span>

                    </div>

                </div>

                <span
                    class="category-arrow"
                    aria-hidden="true"
                >
                    ▼
                </span>

            </button>

            <div class="category-body"></div>
        `;


        const header =
            categoryElement.querySelector(
                ".category-header"
            );

        const body =
            categoryElement.querySelector(
                ".category-body"
            );


        for (const item of items) {

            body.appendChild(
                createItemElement(
                    item,
                    isAchievements
                )
            );
        }


        header.addEventListener(
            "click",
            () => {

                const wasOpen =
                    categoryElement.classList.contains(
                        "open"
                    );


                document
                    .querySelectorAll(
                        ".category.open"
                    )
                    .forEach(
                        openCategory => {
                            openCategory.classList.remove(
                                "open"
                            );
                        }
                    );


                if (!wasOpen) {

                    categoryElement.classList.add(
                        "open"
                    );
                }
            }
        );


        if (currentSearch) {
            categoryElement.classList.add(
                "open"
            );
        }


        categoriesElement.appendChild(
            categoryElement
        );
    }


    if (!visibleCategoryCount) {

        categoriesElement.innerHTML = `
            <div class="no-results">
                No goals or achievements match
                "<strong>${escapeHtml(
                    currentSearch
                )}</strong>".
            </div>
        `;
    }
}


/* =========================
   ITEM RENDER
========================= */

function createItemElement(
    item,
    isAchievement
) {

    const wrapper =
        document.createElement("label");

    wrapper.className = "check-item";


    const completed =
        isAchievement
            ? isAchievementCompleted(
                getCurrentProfile(),
                item.id
            )
            : isGoalCompleted(
                item.id
            );


    if (completed) {
        wrapper.classList.add(
            "completed"
        );
    }


    const difficulty =
        String(
            item.difficulty ||
            DEFAULT_DIFFICULTY
        ).toLowerCase();


    const badge =
        isAchievement
            ? `
                <span class="achievement-score">
                    <strong>
                        ${Number(
                            item.gamerscore
                        ) || 0}
                    </strong>
                    G
                </span>
            `
            : `
                <span
                    class="item-badge ${escapeAttribute(
                        difficulty
                    )}"
                >
                    ${escapeHtml(
                        difficulty
                    )}
                    ·
                    ${getGoalScore(item)}G
                </span>
            `;


    wrapper.innerHTML = `
        <span class="check-box">

            <input
                type="checkbox"
                ${completed ? "checked" : ""}
            >

            <span
                class="check-mark"
                aria-hidden="true"
            >
                ✓
            </span>

        </span>

        <span class="item-content">

            <span class="item-text">
                ${escapeHtml(
                    item.text ||
                    item.name ||
                    "Unnamed item"
                )}
            </span>

            ${
                isAchievement &&
                item.requirement
                    ? `
                        <span class="item-requirement">
                            ${escapeHtml(
                                item.requirement
                            )}
                        </span>
                    `
                    : ""
            }

        </span>

        ${badge}
    `;


    const checkbox =
        wrapper.querySelector(
            "input"
        );


    checkbox.addEventListener(
        "change",
        () => {

            setItemCompleted(
                item,
                checkbox.checked,
                isAchievement
            );
        }
    );


    return wrapper;
}


/* =========================
   ITEM STATE
========================= */

function setItemCompleted(
    item,
    completed,
    isAchievement
) {

    if (isAchievement) {

        const profile =
            getCurrentProfile();

        if (!profile) {
            checkboxSafetyRefresh();
            return;
        }

        if (!profile.achievements) {
            profile.achievements = {};
        }

        profile.achievements[item.id] =
            Boolean(completed);

        saveProfiles();

    } else {

        sharedGoals[item.id] =
            Boolean(completed);

        saveGoals();
    }


    renderAll();
}


/*
    If an achievement is clicked without
    an available profile, restore the UI.
*/
function checkboxSafetyRefresh() {
    renderAll();
}


/* =========================
   SEARCH
========================= */

function matchesSearch(
    item,
    category
) {

    if (!currentSearch) {
        return true;
    }

    const query =
        currentSearch.toLowerCase();


    const text =
        [
            category?.title,
            item?.text,
            item?.name,
            item?.requirement,
            item?.difficulty
        ]
            .filter(Boolean)
            .join(" ")
            .toLowerCase();


    return text.includes(query);
}


/* =========================
   DASHBOARD
========================= */

function renderDashboard() {

    const currentProfile =
        getCurrentProfile();


    const sharedGoalScore =
        getSharedGoalScore();

    const goalCompleted =
        getSharedGoalCompletedCount();

    const totalGoals =
        getNormalGoals().length;


    const achievementCount =
        getProfileAchievementCount(
            currentProfile
        );

    const achievementScore =
        getProfileAchievementScore(
            currentProfile
        );

    const totalAchievements =
        getAchievements().length;


    const currentScore =
        sharedGoalScore +
        achievementScore;


    const globalScore =
        getGlobalScore();

    const globalPossible =
        getGlobalPossibleScore();


    globalScoreElement.textContent =
        globalScore;

    globalScoreSubtextElement.textContent =
        `${globalScore} / ${globalPossible} possible`;


    profileScoreElement.textContent =
        currentScore;


    profileRankElement.textContent =
        getRank(currentScore).name;


    achievementProgressElement.textContent =
        achievementCount;


    achievementProgressElement.parentElement
        .querySelector("small")
        .textContent =
        `/ ${totalAchievements}`;


    achievementScoreTextElement.textContent =
        `${achievementScore}G earned`;


    goalProgressElement.textContent =
        goalCompleted;


    goalProgressElement.parentElement
        .querySelector("small")
        .textContent =
        "completed";


    goalScoreTextElement.textContent =
        `${sharedGoalScore}G earned`;


    const possible =
        getTotalGoalScore() +
        (
            getAchievements().reduce(
                (total, achievement) =>
                    total +
                    (
                        Number(
                            achievement.gamerscore
                        ) || 0
                    ),
                0
            )
        );


    const earned =
        sharedGoalScore +
        achievementScore;


    const percentage =
        possible > 0
            ? Math.min(
                100,
                Math.round(
                    (earned / possible) *
                    100
                )
            )
            : 0;


    progressPercentElement.textContent =
        `${percentage}%`;

    progressFillElement.style.width =
        `${percentage}%`;
}


/* =========================
   RESET
========================= */

function resetSharedGoals() {

    sharedGoals = {};

    saveGoals();

    renderAll();
}


function resetCurrentProfileAchievements() {

    const profile =
        getCurrentProfile();

    if (!profile) {
        return;
    }

    profile.achievements = {};

    saveProfiles();

    renderAll();
}


/* =========================
   MODALS
========================= */

function openProfileModal(
    profileId = null
) {

    editingProfileId =
        profileId;

    if (profileId) {

        const profile =
            profiles.find(
                item =>
                    item.id === profileId
            );

        if (!profile) {
            return;
        }

        profileModalTitle.textContent =
            "Rename Profile";

        profileNameInput.value =
            profile.name;

    } else {

        profileModalTitle.textContent =
            "Add Profile";

        profileNameInput.value = "";
    }


    profileModal.classList.add(
        "visible"
    );

    profileModal.setAttribute(
        "aria-hidden",
        "false"
    );


    setTimeout(
        () => {
            profileNameInput.focus();
        },
        50
    );
}


function closeProfileModal() {

    profileModal.classList.remove(
        "visible"
    );

    profileModal.setAttribute(
        "aria-hidden",
        "true"
    );

    editingProfileId = null;

    profileNameInput.value = "";
}


function saveProfileModal() {

    const name =
        profileNameInput.value.trim();


    if (!name) {
        profileNameInput.focus();
        return;
    }


    if (editingProfileId) {

        renameProfile(
            editingProfileId,
            name
        );

    } else {

        addProfile(name);
    }


    closeProfileModal();
}


function openConfirmModal(
    text,
    action
) {

    confirmModalText.textContent =
        text;

    confirmAction =
        action;

    confirmModal.classList.add(
        "visible"
    );

    confirmModal.setAttribute(
        "aria-hidden",
        "false"
    );
}


function closeConfirmModal() {

    confirmModal.classList.remove(
        "visible"
    );

    confirmModal.setAttribute(
        "aria-hidden",
        "true"
    );

    confirmAction = null;
}


/* =========================
   EVENTS
========================= */

searchInput.addEventListener(
    "input",
    () => {

        currentSearch =
            searchInput.value.trim();

        renderCategories();
    }
);


addProfileButton.addEventListener(
    "click",
    () => {

        if (
            profiles.length >=
            MAX_PROFILES
        ) {
            return;
        }

        openProfileModal();
    }
);


resetButton.addEventListener(
    "click",
    () => {

        openConfirmModal(
            "Reset all shared survival goals? Achievement progress will not be affected.",
            resetSharedGoals
        );
    }
);


profileCancelButton.addEventListener(
    "click",
    closeProfileModal
);


profileSaveButton.addEventListener(
    "click",
    saveProfileModal
);


profileNameInput.addEventListener(
    "keydown",
    event => {

        if (event.key === "Enter") {
            saveProfileModal();
        }

        if (event.key === "Escape") {
            closeProfileModal();
        }
    }
);


confirmCancelButton.addEventListener(
    "click",
    closeConfirmModal
);


confirmOkayButton.addEventListener(
    "click",
    () => {

        if (typeof confirmAction === "function") {
            confirmAction();
        }

        closeConfirmModal();
    }
);


profileModal.addEventListener(
    "click",
    event => {

        if (
            event.target ===
            profileModal
        ) {
            closeProfileModal();
        }
    }
);


confirmModal.addEventListener(
    "click",
    event => {

        if (
            event.target ===
            confirmModal
        ) {
            closeConfirmModal();
        }
    }
);


profilesElement.addEventListener(
    "click",
    event => {

        const button =
            event.target.closest(
                "button[data-action]"
            );

        if (!button) {
            return;
        }


        const action =
            button.dataset.action;

        const id =
            button.dataset.id;


        if (action === "select") {

            selectProfile(id);

            return;
        }


        if (action === "rename") {

            openProfileModal(id);

            return;
        }


        if (action === "delete") {

            const profile =
                profiles.find(
                    item => item.id === id
                );

            if (!profile) {
                return;
            }


            openConfirmModal(
                `Delete the profile "${profile.name}"? Its achievement progress will be lost.`,
                () => deleteProfile(id)
            );
        }
    }
);


/* =========================
   ESCAPE KEY
========================= */

document.addEventListener(
    "keydown",
    event => {

        if (event.key !== "Escape") {
            return;
        }

        closeProfileModal();
        closeConfirmModal();
    }
);


/* =========================
   HTML SAFETY
========================= */

function escapeHtml(value) {

    return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
}


function escapeAttribute(value) {

    return escapeHtml(value);
}


/* =========================
   RENDER EVERYTHING
========================= */

function renderAll() {

    renderDashboard();

    renderProfiles();

    renderCategories();
}


/* =========================
   LOAD JSON
========================= */

async function loadGoals() {

    try {

        const response =
            await fetch(
                GOALS_FILE,
                {
                    cache: "no-store"
                }
            );


        if (!response.ok) {
            throw new Error(
                `HTTP ${response.status}`
            );
        }


        goalsData =
            await response.json();


        if (
            !goalsData ||
            !Array.isArray(
                goalsData.categories
            )
        ) {
            throw new Error(
                "goals.json does not contain categories[]"
            );
        }


        loadStorage();


        if (!profiles.length) {

            /*
                Create one default profile only
                when the site has never had one.
            */

            profiles.push({
                id: createProfileId(),
                name: "Player 1",
                achievements: {}
            });

            activeProfileId =
                profiles[0].id;

            saveProfiles();
            saveActiveProfile();
        }


        renderAll();

    } catch (error) {

        console.error(
            "Unable to load goals.json:",
            error
        );


        categoriesElement.innerHTML = `
            <div class="no-results">
                <strong>
                    Unable to load goals.json
                </strong>
                <br>
                <span>
                    Make sure goals.json is in the same
                    folder as index.html and uses the
                    categories[] structure.
                </span>
            </div>
        `;
    }
}


/* =========================
   START
========================= */

loadGoals();

</script>

</body>
</html>